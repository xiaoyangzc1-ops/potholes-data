<view class="container">
  <view class="card" wx:if="{{!isCoach}}">
    <view class="title">仅教练可创建任务</view>
  </view>

  <view class="card" wx:if="{{isCoach}}">
    <view class="title">创建每周填表任务</view>
    <view class="form-label">周一日期</view>
    <input class="input" value="{{weekStartDate}}" bindinput="onWeekStartDateInput" placeholder="YYYY-MM-DD" />

    <view class="form-label">每日开始时间</view>
    <input class="input" value="{{dailyStartTime}}" bindinput="onDailyStartInput" placeholder="08:00" />

    <view class="form-label">每日结束时间</view>
    <input class="input" value="{{dailyEndTime}}" bindinput="onDailyEndInput" placeholder="23:00" />

    <view class="form-label">最短训练时长（分钟）</view>
    <input class="input" type="number" value="{{minTrainingDuration}}" bindinput="onMinDurationInput" />

    <view class="form-label">本周被 @ 成员</view>
    <checkbox-group bindchange="onTargetMembersChange">
      <label wx:for="{{members}}" wx:key="id" style="display:block;margin-bottom:8rpx;">
        <checkbox value="{{item.id}}" checked="{{selectedMemberIdsMap[item.id]}}" /> {{item.name}}
      </label>
    </checkbox-group>

    <button class="btn-primary" style="margin-top:16rpx;" bindtap="onCreateTask">发布任务（模拟）</button>
  </view>
</view>
